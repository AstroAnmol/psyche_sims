### Settling particles in new psyche gravity ###

### Initialization
# Preliminaries
units           si
atom_style      hybrid granular dipole
atom_modify     sort 10000 0

# boundaries
boundary        f f fs

newton          off
hard_particles  yes
communicate     single vel yes

# the product of the processors must equal P, the number of processors used when running the file: mpirun -np 4 ...
processors      6 5 4
# running on 120 processors on dustiest

#############################
read_restart ../field_0100uT/restart_mix_25_high_0100uT_settled.static

### VARIABLES DEFINITION

# Dimensions of the box
variable        dom_length equal 0.300 # 300 mm
variable        dom_width  equal 0.100 # 100 mm
variable        dom_height equal 0.160 # 160 mm
variable        mid_wall   equal 0.150 # 150 mm


variable        dom_diag equal sqrt(${dom_length}*${dom_length}+${dom_width}*${dom_width}+${dom_height}*${dom_height})

# Particle properties
variable        particle_dia equal 0.010 # 10 mm
variable        particle_radius equal ${particle_dia}/2

# Neighbor skin distance 
# use the first one for non-magnetic case
# variable        skin_dist equal  2*${particle_dia} #meters 2 diameters, overall 3 diameters 
variable        skin_dist equal  ${dom_diag} # domain diagonal for magnetic sims

################################
# Material properties
################################

# METALLIC REGOLITH (KAMACITE, Fe-Ni ALLOY)
variable        density_kamacite equal 7870 # kg/m3 # Tanton et al 2020
variable        youngsM_kamacite equal 150.96e7 # N/m^2 # Tang 2023
variable        poissons_kamacite equal 0.17 # Tang 2023
variable        mag_susc_kamacite equal 20.0 # Assumed

# METALLIC REGOLITH (TROILITE, FeS)
variable        density_troilite equal 4900 # kg/m3 # Tanton et al 2020
variable        youngsM_troilite equal 6.0e9 # N/m^2 # Tang 2023
variable        poissons_troilite equal 0.25 # Tang 2023
variable        mag_susc_troilite equal 5.0 # Assumed

# ROCKY ASTEROID REGOLITH (Frizzell et al 2025)
variable        density_rocky equal 2500 # kg/m3
variable        youngsM_rocky equal 5e6 # N/m^2
variable        poissons_rocky equal 0.20
variable        mag_susc_rocky equal 0.0 # NOT MAGNETIC

# Acrylic (Sikka et al 2026)
variable        density_acrylic equal 1250 # kg/m3
variable        youngsM_acrylic equal 3e7 # N/m^2
variable        poissons_acrylic equal 0.4
variable        mag_susc_acrylic equal 0.0 # NOT MAGNETIC

################################
# Choosing material for particles, walls and floor
# Change these variables to change material types
################################

# Particle material type 1
# Using Kamacite for high magnetic susceptibility case
variable        density_particle1 equal ${density_kamacite}
variable        youngsM_particle1 equal ${youngsM_kamacite}
variable        poissons_particle1 equal ${poissons_kamacite}
variable        magnetic_susc_particle1 equal ${mag_susc_kamacite}

# Particle material type 2
# Using Rocky material for mixture
variable        density_particle2 equal ${density_rocky}
variable        youngsM_particle2 equal ${youngsM_rocky}
variable        poissons_particle2 equal ${poissons_rocky}
variable        magnetic_susc_particle2 equal ${mag_susc_rocky}

# Floor material type
# Same as particles type 1 - Kamacite
variable        density_floor equal ${density_kamacite}
variable        youngsM_floor equal ${youngsM_kamacite}
variable        poissons_floor equal ${poissons_kamacite}
variable        magnetic_susc_floor equal ${mag_susc_kamacite}

# Wall material type
# Using Acrylic for walls
variable        density_wall equal ${density_acrylic}
variable        youngsM_wall equal ${youngsM_acrylic}
variable        poissons_wall equal ${poissons_acrylic}
variable        magnetic_susc_wall equal ${mag_susc_acrylic}
# ################################

# KEEPING FRICTION, RESTITUTION, COHESION CONSTANT FOR ALL SIMULATIONS
# BASED ON FRIZZELL ET AL 2025 and SIKKA ET AL 2026

# Friction Properties
variable        friction_coeff_11 equal 1.0 # metallic-metallic
variable        friction_coeff_12 equal 1.0 # metallic-rocky
variable        friction_coeff_13 equal 1.0 # metallic-floor
variable        friction_coeff_14 equal 0.1 # metallic-wall

variable        friction_coeff_21 equal ${friction_coeff_12}
variable        friction_coeff_22 equal 1.0 # Rocky-rocky 
variable        friction_coeff_23 equal 1.0 # Rocky-floor 
variable        friction_coeff_24 equal 0.1 # Rocky-wall 

variable        friction_coeff_31 equal ${friction_coeff_13}
variable        friction_coeff_32 equal ${friction_coeff_23}
variable        friction_coeff_33 equal 0.1 # floor-floor (doesn't interact)
variable        friction_coeff_34 equal 0.1 # wall-floor (doesn't interact)

variable        friction_coeff_41 equal ${friction_coeff_14}
variable        friction_coeff_42 equal ${friction_coeff_24}
variable        friction_coeff_43 equal ${friction_coeff_34}
variable        friction_coeff_44 equal 0.1 # wall-wall (doesn't interact) 

# Rolling Friction Properties

# Rolling friction coefficient
variable        rolling_coeff_11 equal 0.7 # metallic-metallic
variable        rolling_coeff_12 equal 0.7 # metallic-rocky
variable        rolling_coeff_13 equal 0.7 # metallic-floor
variable        rolling_coeff_14 equal 0.01 # metallic-wall

variable        rolling_coeff_21 equal ${rolling_coeff_12}
variable        rolling_coeff_22 equal 0.7 # rocky-rocky
variable        rolling_coeff_23 equal 0.7 # rocky-floor
variable        rolling_coeff_24 equal 0.01 # rocky-wall

variable        rolling_coeff_31 equal ${rolling_coeff_13}
variable        rolling_coeff_32 equal ${rolling_coeff_23}
variable        rolling_coeff_33 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_coeff_34 equal 0.01 # wall-floor (doesn't interact)

variable        rolling_coeff_41 equal ${rolling_coeff_14}
variable        rolling_coeff_42 equal ${rolling_coeff_24}
variable        rolling_coeff_43 equal ${rolling_coeff_34}
variable        rolling_coeff_44 equal 0.01 # wall-wall (doesn't interact)

# Rolling Damp
variable        rolling_damp_11 equal 2.0 # metallic-metallic
variable        rolling_damp_12 equal 2.0 # metallic-rocky
variable        rolling_damp_13 equal 2.0 # metallic-floor
variable        rolling_damp_14 equal 0.01 # metallic-wall

variable        rolling_damp_21 equal ${rolling_damp_12}
variable        rolling_damp_22 equal 2.0 # rocky-rocky 
variable        rolling_damp_23 equal 2.0 # floor-rocky 
variable        rolling_damp_24 equal 0.01 # rocky-wall

variable        rolling_damp_31 equal ${rolling_damp_13}
variable        rolling_damp_32 equal ${rolling_damp_23}
variable        rolling_damp_33 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_damp_34 equal 0.01 # wall-floor (doesn't interact)

variable        rolling_damp_41 equal ${rolling_damp_14}
variable        rolling_damp_42 equal ${rolling_damp_24}
variable        rolling_damp_43 equal ${rolling_damp_34}
variable        rolling_damp_44 equal 0.01 # wall-wall (doesn't interact)

# Coefficient of Restitution
variable        coeff_rest_11 equal 0.85 # metallic-metallic
variable        coeff_rest_12 equal 0.85  # metallic-rocky
variable        coeff_rest_13 equal 0.85  # metallic-floor
variable        coeff_rest_14 equal 0.4  # metallic-wall

variable        coeff_rest_21 equal ${coeff_rest_12}
variable        coeff_rest_22 equal 0.85 # rocky-rocky 
variable        coeff_rest_23 equal 0.85 # rocky-floor 
variable        coeff_rest_24 equal 0.4 # rocky-wall

variable        coeff_rest_31 equal ${coeff_rest_13}
variable        coeff_rest_32 equal ${coeff_rest_23}
variable        coeff_rest_33 equal 0.4 # floor-floor (doesn't interact)
variable        coeff_rest_34 equal 0.4 # wall-floor (doesn't interact)

variable        coeff_rest_41 equal ${coeff_rest_14}
variable        coeff_rest_42 equal ${coeff_rest_24}
variable        coeff_rest_43 equal ${coeff_rest_34}
variable        coeff_rest_44 equal 0.4 # wall-wall (doesn't interact)

# Cohesion Energy Density (J/m3)
variable        cohesion_energy equal 1e3
variable        cohesion_energy_11 equal ${cohesion_energy} # metallic-metallic
variable        cohesion_energy_12 equal ${cohesion_energy} # metallic-rocky
variable        cohesion_energy_13 equal ${cohesion_energy} # metallic-floor
variable        cohesion_energy_14 equal 0.0 # metallic-wall 

variable        cohesion_energy_21 equal ${cohesion_energy_12}
variable        cohesion_energy_22 equal ${cohesion_energy} # rocky-rocky 
variable        cohesion_energy_23 equal ${cohesion_energy} # rocky-floor 
variable        cohesion_energy_24 equal 0.0 # rocky-wall 

variable        cohesion_energy_31 equal ${cohesion_energy_13}
variable        cohesion_energy_32 equal ${cohesion_energy_23}
variable        cohesion_energy_33 equal 0.0 # floor-floor (doesn't interact)
variable        cohesion_energy_34 equal 0.0 # wall-floor (doesn't interact)

variable        cohesion_energy_41 equal ${cohesion_energy_14}
variable        cohesion_energy_42 equal ${cohesion_energy_24}
variable        cohesion_energy_43 equal ${cohesion_energy_34}
variable        cohesion_energy_44 equal 0.0 # wall-wall (doesn't interact)

# Force properties
variable        earth_g equal 9.82 #m/s^2
variable        psyche_g equal 0.13 #m/s^2
variable        mag_B_F equal 100e-6 # 100 uT (B field)
variable        mag_H_F equal ${mag_B_F}*795774.71545947673925 # A/m (H field)


# Time steps
variable        dt equal 2e-6 # s every 2 microseconds
variable        dumptime equal 1e-3 # s every millisecond
variable        dumpstep equal ${dumptime}/${dt}
variable        thermostep equal ${dumpstep}
variable        checktimestep equal 2e-3/${dt} 
variable        neighstep equal 1e-2/${dt} # create a new neigh list 

# MAGNETIC TIME NEEDED IF MAGNETIC FORCES ARE USED
variable        magtime equal 4e-3 
variable        magstep equal ${magtime}/${dt} # calculate new magnetic forces every magstep steps

# Variables for run times
variable        half_second_steps equal 0.5/${dt} # number of steps for 0.5 seconds time
variable        one_second_steps equal 1/${dt} # number of steps for 1.0 seconds time
variable        0_1_second_steps equal 0.1/${dt}
variable        two_second_steps equal 2.0/${dt} # number of steps for 2.0 seconds time
variable        three_second_steps equal 3.0/${dt} # number of steps for 3.0 seconds time

## DEFINITING SIM PROPERTIES
# Neighbor skin style - atom pairs within a neighbor cutoff distance = force cutoff + skin distance, styele = bin
neighbor        ${skin_dist} bin
# neigh_modify delay 0, this is the default, rebuild neighbor list every timestep
neigh_modify    delay 0 one 5000 every ${neighstep} check no

fix             m1 all property/global youngsModulus peratomtype ${youngsM_particle1} ${youngsM_particle2} ${youngsM_floor} ${youngsM_wall} 
fix             m2 all property/global poissonsRatio peratomtype ${poissons_particle1} ${poissons_particle2} ${poissons_floor} ${poissons_wall} 
fix             m3 all property/global coefficientRestitution peratomtypepair 4 ${coeff_rest_11} ${coeff_rest_12} ${coeff_rest_13} ${coeff_rest_14} &
                                        ${coeff_rest_21} ${coeff_rest_22} ${coeff_rest_23} ${coeff_rest_24} ${coeff_rest_31} ${coeff_rest_32} &
                                        ${coeff_rest_33} ${coeff_rest_34} ${coeff_rest_41} ${coeff_rest_42} ${coeff_rest_43} ${coeff_rest_44}

fix             m4 all property/global coefficientFriction peratomtypepair 4 ${friction_coeff_11} ${friction_coeff_12} ${friction_coeff_13} ${friction_coeff_14} &
                                ${friction_coeff_21} ${friction_coeff_22} ${friction_coeff_23} ${friction_coeff_24} ${friction_coeff_31} ${friction_coeff_32} ${friction_coeff_33} ${friction_coeff_34} &
                                ${friction_coeff_41} ${friction_coeff_42} ${friction_coeff_43} ${friction_coeff_44}

fix             m5 all property/global coefficientRollingFriction peratomtypepair 4 ${rolling_coeff_11} ${rolling_coeff_12} ${rolling_coeff_13} ${rolling_coeff_14} &
                                        ${rolling_coeff_21} ${rolling_coeff_22} ${rolling_coeff_23} ${rolling_coeff_24} ${rolling_coeff_31} ${rolling_coeff_32} ${rolling_coeff_33} ${rolling_coeff_34} &
                                        ${rolling_coeff_41} ${rolling_coeff_42} ${rolling_coeff_43} ${rolling_coeff_44}

fix             m6 all property/global coefficientRollingViscousDamping peratomtypepair 4 ${rolling_damp_11} ${rolling_damp_12} ${rolling_damp_13} ${rolling_damp_14} &
                                        ${rolling_damp_21} ${rolling_damp_22} ${rolling_damp_23} ${rolling_damp_24} ${rolling_damp_31} ${rolling_damp_32} ${rolling_damp_33} ${rolling_damp_34} &
                                        ${rolling_damp_41} ${rolling_damp_42} ${rolling_damp_43} ${rolling_damp_44}

fix             m8 all property/global cohesionEnergyDensity peratomtypepair 4 ${cohesion_energy_11} ${cohesion_energy_12} ${cohesion_energy_13} ${cohesion_energy_14} &
                                    ${cohesion_energy_21} ${cohesion_energy_22} ${cohesion_energy_23} ${cohesion_energy_24} ${cohesion_energy_31} ${cohesion_energy_32} ${cohesion_energy_33} ${cohesion_energy_34} &
                                    ${cohesion_energy_41} ${cohesion_energy_42} ${cohesion_energy_43} ${cohesion_energy_44}

fix             m9 all property/global magneticSusceptibility peratomtype ${magnetic_susc_particle1}  ${magnetic_susc_particle2} ${magnetic_susc_floor} ${magnetic_susc_wall}

## Pair style
pair_style      gran model hertz tangential history cohesion sjkr rolling_friction epsd torsionTorque on
pair_coeff	    * *  # the asterisks set force field coeefficients for all atom types, but then no other args? ASK TOM

## box walls - define simulation 	
fix		        wall_z1 all wall/gran model hertz tangential history primitive type 4 zplane 0.0        #floor
fix		        wall_z2 all wall/gran model hertz tangential history primitive type 4 zplane ${dom_height}
fix             wall_x1 all wall/gran model hertz tangential history primitive type 4 xplane 0.0            
fix             wall_x2 all wall/gran model hertz tangential history primitive type 4 xplane ${dom_length}  
fix             wall_y1 all wall/gran model hertz tangential history primitive type 4 yplane 0.0            
fix             wall_y2 all wall/gran model hertz tangential history primitive type 4 yplane ${dom_width}

## wall in centre which is removed to simulate mass wasting
fix             wall_center all wall/gran model hertz tangential history primitive type 4 xplane ${mid_wall}

# Gravity
# setting the particle assembly in earth gravity
fix             grav all gravity ${psyche_g} vector 0.0 0.0 -1.0 # negative z

# fix magnetic field
fix             mag all magnetic    0 0 ${mag_H_F} ${magstep} inclusion convergence
fix             ctm all check/timestep/mag ${magstep} 0.005

# Time step
timestep        ${dt} #seconds 

## Thermo settings
# thermo style custom says what thermo data we want printed at each thermo timestep - timestep, num atoms, kinetic energy, volume
thermo_style 	custom step atoms ke vol
# thermo output every therostep timesteps
thermo		    ${thermostep}
# LIGGGHTS will ignore last particles and will not normalize against num atoms
thermo_modify	lost ignore norm no

## Particle insertion
variable        2_5_particle_rad equal ${particle_radius}*2.5
variable        number_of_particles equal 1600

variable        fill_height equal 0.100 #mm
variable        floor_height equal 0.00816497
variable        fill_height_f equal ${floor_height}+${fill_height}

### Detailed settings
# apply nve integration to all particles that are inserted as single particles
fix		        integr prtcls nve/sphere update dipole


# Check time step and initialize dump file
fix             ctg all check/timestep/gran ${checktimestep} 0.01 0.01
# run             1
# unfix           ctg

# Create imaging information
dump            dmp all custom ${dumpstep} results/dump*.post id type x y z vx vy vz radius fx fy fz magfx magfy magfz mux muy muz mass


# ensure particles are static 
velocity       all set 0. 0. 0.

## freeze
fix             floor_freeze pts_floor freeze

run          0

change_box      all boundary f f fs x final 0 ${dom_length} # 300 mm

# particle ground
# region          floor block ${mid_wall} EDGE EDGE EDGE ${particle_radius} ${2_5_particle_rad}
# lattice         hcp ${particle_dia}
# create_atoms    3 region floor
# group           pts_floor region floor
# set             group pts_floor density ${density_floor} diameter ${particle_dia}

unfix           floor_freeze
fix             floor_freeze pts_floor freeze

# Pull the stopper
unfix           wall_center
print           "INFO: Center wall unfix_ed. Stopper pulled."


# --- Avalanche Phase ---
print           "INFO: Starting avalanching simulation for ${two_second_steps} steps (2 seconds)."


# RUN FOR 2.0 SECONDS
run             ${two_second_steps} 
                # "write_restart restart_mag_drop.static"

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_mix_25_high_0100uT_drop_final_2s.static
print           "INFO: Restart file 'restart_mix_25_high_0100uT_drop_final_2s.static' written."

# # RUN FOR 2.0 SECONDS
# run             ${two_second_steps} 

# print           "INFO: Avalanching run for 2 seconds complete."

# write_restart   restart_mix_25_high_0100uT_drop_final_4s.static
# print           "INFO: Restart file 'restart_mix_25_high_0100uT_drop_final_4s.static' written."

# # RUN FOR 2.0 SECONDS
# run             ${two_second_steps} 

# print           "INFO: Avalanching run for 2 seconds complete."

# write_restart   restart_mix_25_high_0100uT_drop_final_6s.static
# print           "INFO: Restart file 'restart_mix_25_high_0100uT_drop_final_6s.static' written."

# # RUN FOR 2.0 SECONDS
# run             ${two_second_steps} 

# print           "INFO: Avalanching run for 2 seconds complete."

# write_restart   restart_mix_25_high_0100uT_drop_final_8s.static
# print           "INFO: Restart file 'restart_mix_25_high_0100uT_drop_final_8s.static' written."

# # RUN FOR 2.0 SECONDS
# run             ${two_second_steps} 

# print           "INFO: Avalanching run for 2 seconds complete."

# write_restart   restart_mix_25_high_0100uT_drop_final_10s.static
# print           "INFO: Restart file 'restart_mix_25_high_0100uT_drop_final_10s.static' written."

# print           "INFO: Main Avalanche Phase Completed."

# print           "INFO: Simulation ended."
# --- End of Script ---