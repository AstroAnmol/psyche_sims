### Avalanching experiment with metallic asteroid regolith particles and high magnetic susceptibility and periodic boundaries


### Initialization
# Preliminaries
units           si
atom_style      hybrid granular dipole
atom_modify     sort 10000 0

# boundaries
boundary        f p f

newton          off
hard_particles  yes
communicate     single vel yes

# the product of the processors must equal P, the number of processors used when running the file: mpirun -np 4 ...
processors      4 3 3

#############################
read_restart ../settle/restart_settled.static

### VARIABLES DEFINITION

# Dimensions of the box
variable        dom_length equal 0.330 # 330 mm
variable        dom_width  equal 0.100 # 100 mm
variable        dom_height equal 0.160 # 160 mm
variable        mid_wall   equal 0.150 # 150 mm


variable        dom_diag equal sqrt(${dom_length}*${dom_length}+${dom_width}*${dom_width}+${dom_height}*${dom_height})

# Particle properties
variable        particle_dia equal 0.010 # 10 mm
variable        particle_radius equal ${particle_dia}/2

# Neighbor skin distance 
# use the first one for non-magnetic case
# variable        skin_dist equal  2*${particle_dia} #meters 2 diameters, overall 3 diameters 
variable        skin_dist equal  ${dom_diag} # domain diagonal for magnetic sims

################################
# Material properties
################################

# TYPE 1: Metallic REGOLITH 
variable        density_metallic equal 7870 # kg/m3 #KAMACITE Tanton et al 2020
variable        youngsM_metallic equal 180e7 # N/m^2 
variable        poissons_metallic equal 0.275

# TYPE 2: Floor Same as Metallic REGOLITH


# ROCKY ASTEROID REGOLITH (Frizell et al 2025)
# variable        density_rocky equal 2500 # kg/m3
# variable        youngsM_rocky equal 5e6 # N/m^2
# variable        poissons_rocky equal 0.20

# TYPE 3: Wall (Acrylic)
variable        density_wall equal 1250 # kg/m3
variable        youngsM_wall equal 3e7 # N/m^2
variable        poissons_wall equal 0.4


# Friction Properties
variable        friction_coeff_11 equal 1.0 # metallic-metallic
variable        friction_coeff_12 equal 1.0 # metallic-floor
variable        friction_coeff_13 equal 1.0 # metallic-wall

variable        friction_coeff_21 equal ${friction_coeff_12}
variable        friction_coeff_22 equal 0.1 # Floor-floor (doesn't interact)
variable        friction_coeff_23 equal 0.1 # Floor-wall (doesn't interact)

variable        friction_coeff_31 equal ${friction_coeff_13}
variable        friction_coeff_32 equal ${friction_coeff_23}
variable        friction_coeff_33 equal 0.1 # wall-wall (doesn't interact)

# Rolling Friction Properties

# Rolling friction coefficient
variable        rolling_coeff_11 equal 0.7 # metallic-metallic
variable        rolling_coeff_12 equal 0.7 # metallic-floor
variable        rolling_coeff_13 equal 0.01 # metallic-wall

variable        rolling_coeff_21 equal ${rolling_coeff_12}
variable        rolling_coeff_22 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_coeff_23 equal 0.01 # wall-floor (doesn't interact)

variable        rolling_coeff_31 equal ${rolling_coeff_13}
variable        rolling_coeff_32 equal ${rolling_coeff_23}
variable        rolling_coeff_33 equal 0.01 # wall-wall (doesn't interact)


# Rolling Damp
variable        rolling_damp_11 equal 2.0 # metallic-metallic
variable        rolling_damp_12 equal 2.0 # metallic-floor
variable        rolling_damp_13 equal 0.01 # metallic-wall

variable        rolling_damp_21 equal ${rolling_damp_12}
variable        rolling_damp_22 equal 0.01 # floor-floor (doesn't interact)
variable        rolling_damp_23 equal 0.01 # wall-floor (doesn't interact)

variable        rolling_damp_31 equal ${rolling_damp_13}
variable        rolling_damp_32 equal ${rolling_damp_23}
variable        rolling_damp_33 equal 0.01 # wall-wall (doesn't interact)

# Coefficient of Restitution
variable        coeff_rest_11 equal 0.85 # metallic-metallic
variable        coeff_rest_12 equal 0.85  # metallic-floor
variable        coeff_rest_13 equal 0.4  # metallic-wall

variable        coeff_rest_21 equal ${coeff_rest_12}
variable        coeff_rest_22 equal 0.4 # floor-floor (doesn't interact)
variable        coeff_rest_23 equal 0.4 # floor-wall (doesn't interact)

variable        coeff_rest_31 equal ${coeff_rest_13}
variable        coeff_rest_32 equal ${coeff_rest_23}
variable        coeff_rest_33 equal 0.4 # wall-wall (doesn't interact)

# Cohesion Energy Density (J/m3)
variable        cohesion_energy equal 1e3
variable        cohesion_energy_11 equal ${cohesion_energy} # metallic-metallic
variable        cohesion_energy_12 equal ${cohesion_energy} # metallic-floor
variable        cohesion_energy_13 equal 0.0 # metallic-wall

variable        cohesion_energy_21 equal ${cohesion_energy_12}
variable        cohesion_energy_22 equal ${cohesion_energy} # floor-floor (doesn't interact)
variable        cohesion_energy_23 equal 0.0 # floor-wall (doesn't interact)

variable        cohesion_energy_31 equal ${cohesion_energy_13}
variable        cohesion_energy_32 equal ${cohesion_energy_23}
variable        cohesion_energy_33 equal 0.0 # wall-wall (doesn't interact)

# Magnetic susceptibility
variable        magnetic_susc_metallic equal 20.0
variable        magnetic_susc_floor equal ${magnetic_susc_metallic}
variable        magnetic_susc_wall equal 0.0

# Force properties
variable        earth_g equal 9.82 #m/s^2
variable        grav_value equal 0.13 #m/s^2

variable        mag_B_F equal 10e-6 # Tesla (31.2 microTesla, Earth field)
variable        mag_H_F equal ${mag_B_F}/(4*3.14159e-7) # A/m

# Time steps
variable        dt equal 5e-6 # s every 5 microseconds
variable        dumptime equal 1e-3 # s every millisecond
variable        dumpstep equal ${dumptime}/${dt}
variable        thermostep equal ${dumpstep}
variable        checktimestep equal 1e-3/${dt} 
variable        magtime equal 1e-3 
variable        magstep equal ${magtime}/${dt} # calculate new magnetic forces every magstep steps
variable        neighstep equal 1e-2/$(dt) # create a new neigh list 



variable        half_second_steps equal 0.5/${dt} # number of steps for 0.5 seconds time
variable        one_second_steps equal 1/${dt} # number of steps for 1.0 seconds time
variable        0_1_second_steps equal 0.1/${dt}
variable        two_second_steps equal 2.0/${dt} # number of steps for 2.0 seconds time

## DEFINITING SIM PROPERTIES
# Neighbor skin style - atom pairs within a neighbor cutoff distance = force cutoff + skin distance, styele = bin
neighbor        ${skin_dist} bin
# neigh_modify delay 0, this is the default, rebuild neighbor list every timestep
neigh_modify    delay 0 one 5000 every ${neighstep} check no

fix             m1 all property/global youngsModulus peratomtype ${youngsM_metallic} ${youngsM_metallic} ${youngsM_wall} 
fix             m2 all property/global poissonsRatio peratomtype ${poissons_metallic} ${poissons_metallic} ${poissons_wall} 
fix             m3 all property/global coefficientRestitution peratomtypepair 3 ${coeff_rest_11} ${coeff_rest_12} ${coeff_rest_13} &
                                        ${coeff_rest_21} ${coeff_rest_22} ${coeff_rest_23} ${coeff_rest_31} ${coeff_rest_32} ${coeff_rest_33}

fix             m4 all property/global coefficientFriction peratomtypepair 3 ${friction_coeff_11} ${friction_coeff_12} ${friction_coeff_13} &
                                ${friction_coeff_21} ${friction_coeff_22} ${friction_coeff_23} ${friction_coeff_31} ${friction_coeff_32} ${friction_coeff_33}

fix             m5 all property/global coefficientRollingFriction peratomtypepair 3 ${rolling_coeff_11} ${rolling_coeff_12} ${rolling_coeff_13} &
                                        ${rolling_coeff_21} ${rolling_coeff_22} ${rolling_coeff_23} ${rolling_coeff_31} ${rolling_coeff_32} ${rolling_coeff_33}

fix             m6 all property/global coefficientRollingViscousDamping peratomtypepair 3 ${rolling_damp_11} ${rolling_damp_12} ${rolling_damp_13} &
                                        ${rolling_damp_21} ${rolling_damp_22} ${rolling_damp_23} ${rolling_damp_31} ${rolling_damp_32} ${rolling_damp_33}

fix             m8 all property/global cohesionEnergyDensity peratomtypepair 3 ${cohesion_energy_11} ${cohesion_energy_12} ${cohesion_energy_13} &
                                    ${cohesion_energy_21} ${cohesion_energy_22} ${cohesion_energy_23} ${cohesion_energy_31} ${cohesion_energy_32} ${cohesion_energy_33}

fix             m9 all property/global magneticSusceptibility peratomtype ${magnetic_susc_metallic} ${magnetic_susc_floor} ${magnetic_susc_wall}

## Pair style
pair_style      gran model hertz tangential history cohesion sjkr rolling_friction epsd torsionTorque on
pair_coeff	    * *  # the asterisks set force field coeefficients for all atom types, but then no other args? ASK TOM

## box walls - define simulation 	
fix		        wall_z1 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 zplane 0.0        #floor
fix		        wall_z2 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 zplane ${dom_height}
fix             wall_x1 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 xplane 0.0            
fix             wall_x2 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 xplane ${dom_length}
# fix             wall_y1 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 yplane 0.0            
# fix             wall_y2 all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 yplane ${dom_width}

## wall in centre which is removed to simulate mass wasting
fix             wall_center all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd primitive type 3 xplane ${mid_wall}

# Gravity
fix             grav all gravity ${grav_value} vector 0.0 0.0 -1.0 # negative z

# Time step
timestep        ${dt} #seconds 

## Thermo settings
# thermo style custom says what thermo data we want printed at each thermo timestep - timestep, num atoms, kinetic energy, volume
thermo_style 	custom step atoms ke vol
# thermo output every therostep timesteps
thermo		    ${thermostep}
# LIGGGHTS will ignore last particles and will not normalize against num atoms
thermo_modify	lost ignore norm no

## Particle insertion
variable        2_5_particle_rad equal ${particle_radius}*2.5
variable        number_of_particles equal 1600

variable        fill_height equal 0.100 #mm
variable        floor_height equal 0.00816497
variable        fill_height_f equal ${floor_height}+${fill_height}

### Detailed settings
# apply nve integration to all particles that are inserted as single particles
fix		        integr prtcls nve/sphere update dipole


# Check time step and initialize dump file
fix             ctg all check/timestep/gran ${checktimestep} 0.01 0.01
# run             1
# unfix           ctg

# Create imaging information
dump            dmp all custom ${dumpstep} results/dump*.post id type x y z vx vy vz radius fx fy fz mass


# ensure particles are static 
velocity       all set 0. 0. 0.

## freeze
fix             floor_freeze pts_floor freeze

run            0

change_box      all boundary f p fs x final 0 ${dom_length} # 280 mm

# particle ground
region          floor block ${mid_wall} EDGE EDGE EDGE ${particle_radius} ${2_5_particle_rad}
lattice         hcp ${particle_dia}
create_atoms    2 region floor
group           pts_floor region floor
set             group pts_floor density ${density_metallic} diameter ${particle_dia}

unfix           floor_freeze
fix             floor_freeze pts_floor freeze

fix             mag all magnetic    0 0 ${mag_H_F} ${magstep} inclusion convergence
fix             ctm all check/timestep/mag ${magstep} 0.005

# Pull the stopper
unfix           wall_center
print           "INFO: Center wall unfix_ed. Stopper pulled."


# --- Avalanche Phase ---
print           "INFO: Starting avalanching simulation for ${two_second_steps} steps (2 seconds)."


# RUN FOR 2.0 SECONDS
run             ${two_second_steps} #pre no #every ${deci_second_steps} &
                # "write_restart restart_mag_drop.static"

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_nomag_drop_final_2s.static
print           "INFO: Restart file 'restart_nomag_drop_final_2s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} #pre no #every ${deci_second_steps} &
                # "write_restart restart_mag_drop.static"

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_nomag_drop_final_4s.static
print           "INFO: Restart file 'restart_nomag_drop_final_4s.static' written."

# RUN FOR 2.0 SECONDS
run             ${two_second_steps} #pre no #every ${deci_second_steps} &
                # "write_restart restart_mag_drop.static"

print           "INFO: Avalanching run for 2 seconds complete."

write_restart   restart_nomag_drop_final_6s.static
print           "INFO: Restart file 'restart_nomag_drop_final_6s.static' written."

print           "INFO: Main Avalanche Phase Completed."

print           "INFO: Simulation ended."
# --- End of Script ---